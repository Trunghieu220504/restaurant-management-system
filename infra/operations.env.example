# Install as /etc/restaurant/operations.env owned root:root mode 0600.
SQL_CONTAINER=restaurant-staging-sqlserver-1
DATABASE=RestaurantManagement
BACKUP_DIRECTORY=/var/backups/restaurant/staging
RCLONE_CONFIG=/etc/restaurant/rclone.conf
BACKUP_REMOTE=r2:REPLACE_PRIVATE_BUCKET/staging
AGE_RECIPIENT=REPLACE_WITH_AGE_PUBLIC_RECIPIENT
# Keep the private recovery key offline; supply only during a restore drill.
AGE_IDENTITY_FILE=/etc/restaurant/recovery.agekey
