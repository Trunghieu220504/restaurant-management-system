# Copy to infra/.env (ignored by git) and fill in real values. Never commit infra/.env.
# Required:
MSSQL_SA_PASSWORD=
JWT_SIGNING_KEY=

# Optional (defaults are defined in the compose files):
# MSSQL_DB=RestaurantManagement
# JWT_ISSUER=restaurant-api
# JWT_AUDIENCE=restaurant-web
# NGINX_INTERNAL_IP=172.30.77.10
# INTERNAL_SUBNET=172.30.77.0/24

# When running published GHCR images (compose.backend.ghcr.yml / compose.frontend.ghcr.yml).
# Owner must be lowercase; the tag is the 40-character commit SHA printed by the publish job.
# GHCR_API_IMAGE=ghcr.io/<owner>/restaurant-api:<sha>
# GHCR_WEB_IMAGE=ghcr.io/<owner>/restaurant-web:<sha>
