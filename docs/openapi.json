{
  "openapi": "3.0.1",
  "info": {
    "title": "Restaurant Management API",
    "version": "1.0.0",
    "description": "Backend API for Restaurant Management Modular Monolith"
  },
  "paths": {
    "/health/live": {
      "get": {
        "tags": ["Health"],
        "summary": "Liveness probe",
        "operationId": "HealthLive",
        "responses": {
          "200": {
            "description": "Healthy"
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": ["Health"],
        "summary": "Readiness probe",
        "operationId": "HealthReady",
        "responses": {
          "200": {
            "description": "Ready"
          },
          "503": {
            "description": "Service Unavailable"
          }
        }
      }
    },
    "/api/system/modules": {
      "get": {
        "tags": ["System"],
        "summary": "Get registered module names",
        "operationId": "GetRegisteredModules",
        "security": [
          {
            "Bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "List of module names",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/api/identity/login": {
      "post": {
        "tags": ["Identity"],
        "summary": "Sign in with username and password",
        "operationId": "IdentityLogin",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/identity/me": {
      "get": {
        "tags": ["Identity"],
        "summary": "Get current authenticated account",
        "operationId": "IdentityCurrentAccount",
        "security": [
          {
            "Bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current account details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentAccount"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/identity/logout": {
      "post": {
        "tags": ["Identity"],
        "summary": "Revoke current session",
        "operationId": "IdentityLogout",
        "security": [
          {
            "Bearer": []
          }
        ],
        "responses": {
          "204": {
            "description": "Logged out successfully"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/identity/change-password": {
      "post": {
        "tags": ["Identity"],
        "summary": "Change password for the current account",
        "operationId": "IdentityChangePassword",
        "security": [
          {
            "Bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Password changed successfully"
          },
          "400": {
            "description": "Invalid input or policy violation",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/salesday/current": {
      "get": {
        "tags": ["SalesDay"],
        "summary": "Get current active business day",
        "operationId": "SalesDayCurrent",
        "security": [
          {
            "Bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current business day or null",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SalesDayDto"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/salesday/open": {
      "post": {
        "tags": ["SalesDay"],
        "summary": "Open a new business day",
        "operationId": "SalesDayOpen",
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OpenSalesDayRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Business day opened",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SalesDayDto"
                }
              }
            }
          },
          "200": {
            "description": "Idempotent replay of previously opened day",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SalesDayDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "409": {
            "description": "Conflict (already open or previous day not closed)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": ["userName", "password"],
        "properties": {
          "userName": {
            "type": "string",
            "maxLength": 256
          },
          "password": {
            "type": "string",
            "maxLength": 1024
          }
        }
      },
      "CurrentAccount": {
        "type": "object",
        "required": ["id", "userName", "roles", "permissions"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "userName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "LoginResult": {
        "type": "object",
        "required": ["accessToken", "expiresAt", "account"],
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "account": {
            "$ref": "#/components/schemas/CurrentAccount"
          }
        }
      },
      "ChangePasswordRequest": {
        "type": "object",
        "required": ["currentPassword", "newPassword"],
        "properties": {
          "currentPassword": {
            "type": "string",
            "maxLength": 1024
          },
          "newPassword": {
            "type": "string",
            "maxLength": 1024
          }
        }
      },
      "OpenSalesDayRequest": {
        "type": "object",
        "required": ["businessDate", "openingCash"],
        "properties": {
          "businessDate": {
            "type": "string",
            "format": "date",
            "example": "2026-11-10"
          },
          "openingCash": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "example": 1000000
          }
        }
      },
      "SalesDayDto": {
        "type": "object",
        "required": ["id", "businessDate", "openingCash", "status", "openedAt"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "businessDate": {
            "type": "string",
            "format": "date"
          },
          "openingCash": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": "string",
            "enum": ["DANG_BAN", "CHO_CHOT", "DA_CHOT"]
          },
          "openedAt": {
            "type": "string",
            "format": "date-time"
          },
          "closedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        },
        "additionalProperties": {}
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Enter JWT Bearer token"
      }
    }
  }
}
